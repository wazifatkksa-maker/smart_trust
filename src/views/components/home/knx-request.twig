{#
| component.label / title / subtitle   | ?string |
| component.box_title / box_text       | ?string |
| component.steps[]                    | title, text |
#}
{% set c = component %}
{# editor-added sections come with one blank item: keep only items that carry content #}
{% set steps = [] %}{% for it in c.steps|default([]) %}{% if it.title or it.text %}{% set steps = steps|merge([it]) %}{% endif %}{% endfor %}
<section id="knx-request" class="st-section st-bg-sand" aria-labelledby="st-knx-{{ position }}">
    <div class="st-container">
        <div class="st-knx">
            <div class="st-knx__intro" data-reveal>
                <span class="st-label"><span class="st-dot st-dot--ink" aria-hidden="true"></span>{{ c.label|default(trans('blocks.knx.label')) }}</span>
                <div class="st-knx__heading">
                    <h2 id="st-knx-{{ position }}" class="st-h2" style="white-space:pre-line">{{ c.title|default(trans('blocks.knx.title')) }}</h2>
                    <p class="st-knx__sub">{{ c.subtitle|default(trans('blocks.knx.subtitle')) }}</p>
                </div>
                <ol class="st-knx__steps">
                    {% if steps|length %}
                        {% for s in steps %}<li><b>{{ s.title }}</b><span>{{ s.text }}</span></li>{% endfor %}
                    {% else %}
                        {% for i in 1..3 %}<li><b>{{ trans('blocks.knx.h' ~ i ~ '_title') }}</b><span>{{ trans('blocks.knx.h' ~ i ~ '_text') }}</span></li>{% endfor %}
                    {% endif %}
                </ol>
            </div>
            <div class="st-knx__form" data-reveal style="--i:1">
                {% include 'components.partials.knx-box' with {uid: 'home-' ~ position, title: c.box_title, text: c.box_text} %}
            </div>
        </div>
    </div>
</section>
