{#
| Variable        | Type   | Description                                   |
|-----------------|--------|-----------------------------------------------|
| store           | Store  | store.name / logo / url / contacts / social   |
| theme           | Theme  | theme.settings.get(), theme.color, theme.font |
| language        | object | language.code                                 |
| page            | object | page.slug / page.title / page.id              |
| cart            | Cart   | cart.items_count                              |
#}
{% set is_home = is_page('index') %}
{% set over_header = is_home and theme.settings.get('header_transparent_home', true) %}
{% set brand_font = theme.settings.get('brand_font', true) %}
{% set wa_setting = theme.settings.get('whatsapp_number', '')|default('') %}
{% set wa_store = store.contacts.whatsapp|default('') %}
{% set st_whatsapp = wa_setting ?: ((wa_store matches '/^[0-9+ ]+$/') ? wa_store : '') %}
{% set st_whatsapp = st_whatsapp|replace({'+': '', ' ': ''}) %}
{% set st_knx_url = theme.settings.get('knx_page_url', '')|default('') ?: store.url ~ '#knx-request' %}
{{ theme.settings.set('st_whatsapp', st_whatsapp) }}
{{ theme.settings.set('st_knx_url', st_knx_url) }}
{{ theme.settings.set('placeholder', 'images/placeholder.webp'|asset) }}
<!DOCTYPE html>
<html lang="{{ language.code }}" dir="{{ theme.is_rtl ? 'rtl' : 'ltr' }}">
<head>
    <meta charset="utf-8">
    {% hook 'head:start' %}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#0B0C0D">
    {% hook head %}

    {% if brand_font %}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+Arabic:wght@300;400;500;600&display=swap">
    {% else %}
        <link rel="stylesheet" href="{{ theme.font.path|cdn }}">
    {% endif %}
    <link rel="stylesheet" href="{{ 'fonts/sallaicons.css'|cdn }}">
    <link rel="stylesheet" href="{{ 'app.css'|asset }}">
    {% block styles %}{% endblock %}

    <style>
        :root {
            --font-main: '{{ theme.font.name }}';
            --color-primary: {{ theme.color.primary }};
            --color-primary-dark: {{ theme.color.darker(0.15) }};
            --color-primary-light: {{ theme.color.lighter(0.15) }};
            --color-primary-reverse: {{ theme.color.reverse_text }};
        }
    </style>

    <script defer src="{{ 'product-card.js'|asset }}"></script>
    {% block head_scripts %}{% endblock %}
    {% hook 'head:end' %}
</head>
<body id="app"
      class="st-body {{ theme.settings.get('animations', true) ? 'st-motion' : '' }} {{ brand_font ? '' : 'st-store-font' }} {{ over_header ? 'st-has-over-header' : '' }} {% block body_classes %}{% endblock %} {% hook 'body:classes' %}"
      data-st-quote="{{ theme.settings.get('quote_keyword', '')|default(trans('blocks.product.quote_keyword')) }}"
      data-st-quote-zero="{{ theme.settings.get('quote_zero_price', false) ? '1' : '0' }}"
      data-st-card-add="{{ theme.settings.get('card_add_button', true) ? '1' : '0' }}"
      data-st-plate="{{ theme.settings.get('card_plate', 'stone')|default('stone') }}"
      {% block body_attrs %}{% endblock %}>
    <a class="st-skip" href="#main-content">{{ trans('blocks.header.skip') }}</a>
    {% hook 'body:start' %}

    {% component 'header.header' %}

    <main id="main-content" role="main" tabindex="-1">
        {% block content %}{% endblock %}
    </main>

    {% component 'footer.footer' %}

    {% include 'components.partials.fab' %}

    <script defer src="{{ 'app.js'|asset }}"></script>

    <salla-offer-modal></salla-offer-modal>
    <salla-search></salla-search>
    <salla-login-modal></salla-login-modal>
    {% if store.scope %}
        <salla-scopes selection="{{ store.scope.display_as }}"></salla-scopes>
    {% endif %}

    {% hook 'body:end' %}
    {% block scripts %}{% endblock %}
</body>
</html>
